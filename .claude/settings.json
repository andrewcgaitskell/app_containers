{
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python3 -m pytest)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m py_compile *)",
      "Bash(bash -n *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/.storage/**)",
      "Read(./data/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.crt)",
      "Read(**/*.log)",
      "Read(**/backups/**)",
      "Read(//run/**)",
      "Read(//var/run/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets.yaml)",
      "Edit(**/secrets.yml)",
      "Edit(**/.storage/**)",
      "Edit(./data/**)",
      "Edit(./.claude/settings.json)",
      "Edit(//run/**)",
      "Edit(//var/run/**)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(podman *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(systemctl *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(git commit *)"
    ]
  }
}
