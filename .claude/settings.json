{
  "permissions": {
    "allow": [
      "Read(/workspace/app_containers/**)",
      "Write(/workspace/app_containers/**)",
      "Edit(/workspace/app_containers/**)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(python3 -m pytest *)"
    ],
    "deny": [
      "Read(/opt/**)",
      "Read(/run/**)",
      "Read(/var/run/**)",
      "Read(/opt/data/app_containers/**/.env*)",
      "Read(/opt/data/app_containers/**/secrets.yaml)",
      "Read(/opt/data/app_containers/**/secrets.yml)",
      "Read(/opt/data/app_containers/**/.storage/**)",
      "Write(/opt/**)",
      "Write(/run/**)",
      "Write(/var/run/**)",
      "Bash(docker *)",
      "Bash(sudo *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
